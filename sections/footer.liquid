{% comment %}
  Hamper Junction — Custom Footer
  Built on Shopify Dawn 16.0.0
{% endcomment %}

{{ 'section-footer.css' | asset_url | stylesheet_tag }}
{{ 'component-newsletter.css' | asset_url | stylesheet_tag }}
{{ 'component-list-menu.css' | asset_url | stylesheet_tag }}
{{ 'component-list-social.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign footer_menu = blank
  assign policies_menu = linklists['policy-links']

  for block in section.blocks
    if block.type == 'link_list' and footer_menu == blank
      assign footer_menu = block.settings.menu
    endif
  endfor

  assign has_social_icons = false

  if settings.social_facebook_link != blank
    assign has_social_icons = true
  elsif settings.social_instagram_link != blank
    assign has_social_icons = true
  elsif settings.social_youtube_link != blank
    assign has_social_icons = true
  elsif settings.social_tiktok_link != blank
    assign has_social_icons = true
  elsif settings.social_twitter_link != blank
    assign has_social_icons = true
  elsif settings.social_pinterest_link != blank
    assign has_social_icons = true
  elsif settings.social_snapchat_link != blank
    assign has_social_icons = true
  elsif settings.social_tumblr_link != blank
    assign has_social_icons = true
  elsif settings.social_vimeo_link != blank
    assign has_social_icons = true
  endif
-%}

<footer
  class="hj-footer color-{{ section.settings.color_scheme }} gradient"
  role="contentinfo"
>
  <div class="hj-footer__inner">
    <!--
      =====================================================
      MAIN FOOTER
      =====================================================
    -->

    <div class="hj-footer__main page-width">
      <!-- BRAND -->

      <div class="hj-footer__brand">
        <a
          href="{{ routes.root_url }}"
          class="hj-footer__logo-link"
          aria-label="{{ shop.name | escape }}"
        >
          <img
            src="{{ 'hamper-junction-logo-white.svg' | asset_url }}"
            class="hj-footer__logo"
            width="220"
            height="86"
            alt="{{ shop.name | escape }}"
            loading="lazy"
          >
        </a>

        {% if section.settings.brand_tagline != blank %}
          <p class="hj-footer__tagline">
            {{ section.settings.brand_tagline }}
          </p>
        {% endif %}

        {% if section.settings.show_social and has_social_icons %}
          <div class="hj-footer__social">
            {% if section.settings.social_heading != blank %}
              <p class="hj-footer__social-label">
                {{ section.settings.social_heading }}
              </p>
            {% endif %}

            {% render 'social-icons' %}
          </div>
        {% endif %}
      </div>

      <!-- QUICK LINKS -->

      <nav
        class="hj-footer__column hj-footer__links"
        aria-label="{{ section.settings.quick_links_heading | escape }}"
      >
        <h2 class="hj-footer__heading">
          {{ section.settings.quick_links_heading }}
        </h2>

        {% if footer_menu != blank %}
          <ul class="hj-footer__menu list-unstyled">
            {% for link in footer_menu.links %}
              <li>
                <a
                  href="{{ link.url }}"
                  class="hj-footer__menu-link"
                >
                  {{ link.title | escape }}
                </a>
              </li>
            {% endfor %}
          </ul>
        {% endif %}
      </nav>

      <!-- POLICIES -->

      {% if section.settings.show_policy %}
        <nav
          class="hj-footer__column hj-footer__policies"
          aria-label="{{ section.settings.policies_heading | escape }}"
        >
          <h2 class="hj-footer__heading">
            {{ section.settings.policies_heading }}
          </h2>

          {% if policies_menu != blank %}
            <ul class="hj-footer__menu list-unstyled">
              {% for link in policies_menu.links %}
                <li>
                  <a
                    href="{{ link.url }}"
                    class="hj-footer__menu-link"
                  >
                    {{ link.title | escape }}
                  </a>
                </li>
              {% endfor %}
            </ul>
          {% endif %}
        </nav>
      {% endif %}

      <!-- NEWSLETTER -->

      {% if section.settings.newsletter_enable %}
        <div class="hj-footer__column hj-footer__newsletter">
          {% if section.settings.newsletter_label != blank %}
            <p class="hj-footer__heading">
              {{ section.settings.newsletter_label }}
            </p>
          {% endif %}

          {% if section.settings.newsletter_heading != blank %}
            <h2 class="hj-footer__newsletter-title">
              {{ section.settings.newsletter_heading }}
            </h2>
          {% endif %}

          {% if section.settings.newsletter_description != blank %}
            <div class="hj-footer__newsletter-description">
              {{ section.settings.newsletter_description }}
            </div>
          {% endif %}

          {% form 'customer', class: 'hj-footer__newsletter-form' %}
            <input
              type="hidden"
              name="contact[tags]"
              value="newsletter"
            >

            <div class="hj-footer__newsletter-field">
              <label
                for="FooterEmail"
                class="visually-hidden"
              >
                Email address
              </label>

              <input
                id="FooterEmail"
                type="email"
                name="contact[email]"
                class="hj-footer__newsletter-input"
                value="{{ form.email }}"
                placeholder="Email address"
                autocomplete="email"
                autocorrect="off"
                autocapitalize="off"
                required
                {% if form.errors %}
                  aria-invalid="true"
                  aria-describedby="FooterEmailError"
                {% endif %}
              >

              <button
                type="submit"
                class="hj-footer__newsletter-button"
                aria-label="Subscribe to newsletter"
              >
                <span aria-hidden="true">→</span>
              </button>
            </div>

            {% if form.errors %}
              <div
                id="FooterEmailError"
                class="hj-footer__newsletter-message hj-footer__newsletter-message--error"
              >
                {{ form.errors.translated_fields.email | capitalize }}
                {{ form.errors.messages.email }}
              </div>
            {% endif %}

            {% if form.posted_successfully? %}
              <div
                class="hj-footer__newsletter-message hj-footer__newsletter-message--success"
              >
                Thank you for subscribing.
              </div>
            {% endif %}
          {% endform %}
        </div>
      {% endif %}
    </div>

    <!--
      =====================================================
      FOOTER BOTTOM
      =====================================================
    -->

    <div class="hj-footer__bottom">
      <div class="hj-footer__bottom-inner page-width">
        <p class="hj-footer__copyright">
          © {{ 'now' | date: '%Y' }}
          {{ shop.name }}
        </p>

        <p class="hj-footer__credit">
          Site designed and maintained by
          <a
            href="https://dedicateddesigner.in/"
            target="_blank"
            rel="noopener noreferrer"
          >
            Dedicated Designer
          </a>
        </p>
      </div>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "settings": [
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Color scheme",
      "default": "scheme-1"
    },
    {
      "type": "checkbox",
      "id": "newsletter_enable",
      "default": true,
      "label": "Enable newsletter"
    },
    {
      "type": "text",
      "id": "newsletter_label",
      "label": "Newsletter label",
      "default": "STAY IN THE LOOP"
    },
    {
      "type": "text",
      "id": "newsletter_heading",
      "label": "Newsletter heading",
      "default": "Thoughtful gifting, beautifully presented."
    },
    {
      "type": "richtext",
      "id": "newsletter_description",
      "label": "Newsletter description",
      "default": "<p>Be the first to discover new hampers, seasonal gifting and thoughtful ideas.</p>"
    },
    {
      "type": "text",
      "id": "brand_tagline",
      "label": "Brand tagline",
      "default": "Thoughtfully curated gifts, beautifully presented."
    },
    {
      "type": "text",
      "id": "quick_links_heading",
      "label": "Quick links heading",
      "default": "QUICK LINKS"
    },
    {
      "type": "text",
      "id": "policies_heading",
      "label": "Policies heading",
      "default": "POLICIES"
    },
    {
      "type": "link_list",
      "id": "policies_menu",
      "label": "Policies menu",
      "default": "footer"
    },
    {
      "type": "text",
      "id": "social_heading",
      "label": "Social heading",
      "default": "FOLLOW US"
    },
    {
      "type": "checkbox",
      "id": "show_social",
      "default": true,
      "label": "Show social icons"
    },
    {
      "type": "checkbox",
      "id": "show_policy",
      "default": true,
      "label": "Show policy links"
    },
    {
      "type": "checkbox",
      "id": "enable_follow_on_shop",
      "default": false,
      "label": "Show Shop follow button"
    },
    {
      "type": "checkbox",
      "id": "payment_enable",
      "default": false,
      "label": "Show payment icons"
    },
    {
      "type": "checkbox",
      "id": "enable_country_selector",
      "default": false,
      "label": "Show country selector"
    },
    {
      "type": "checkbox",
      "id": "enable_language_selector",
      "default": false,
      "label": "Show language selector"
    },
    {
      "type": "range",
      "id": "margin_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top margin",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 36
    }
  ],
  "blocks": [
    {
      "type": "link_list",
      "name": "Quick links",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Quick links"
        },
        {
          "type": "link_list",
          "id": "menu",
          "label": "Menu",
          "default": "footer"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Footer"
    }
  ]
}
{% endschema %}
