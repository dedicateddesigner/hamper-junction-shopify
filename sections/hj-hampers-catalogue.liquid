<section
  id="hj-hampers-catalogue-{{ section.id }}"
  class="hj-catalogue"
>
  <div class="page-width">
    <header class="hj-catalogue__header">
      {% if section.settings.eyebrow != blank %}
        <p class="hj-catalogue__eyebrow">
          {{ section.settings.eyebrow }}
        </p>
      {% endif %}

      {% if section.settings.heading != blank %}
        <h1 class="hj-catalogue__heading">
          {{ section.settings.heading }}
        </h1>
      {% endif %}

      {% if section.settings.description != blank %}
        <div class="hj-catalogue__description rte">
          {{ section.settings.description }}
        </div>
      {% endif %}
    </header>

    {% comment %}
      COLLECTION GROUPS
      Each selected collection is rendered as its own section.
    {% endcomment %}

    {% assign collection_count = 0 %}

    {% if section.settings.home_collection != blank %}
      {% assign collection_count = collection_count | plus: 1 %}
    {% endif %}

    {% if section.settings.celebrations_collection != blank %}
      {% assign collection_count = collection_count | plus: 1 %}
    {% endif %}

    {% if section.settings.gourmet_collection != blank %}
      {% assign collection_count = collection_count | plus: 1 %}
    {% endif %}

    {% if section.settings.seasonal_collection != blank %}
      {% assign collection_count = collection_count | plus: 1 %}
    {% endif %}

    {% if collection_count > 0 %}
      <div class="hj-catalogue__groups">
        {% comment %}
          HOME & HOUSEWARMING
        {% endcomment %}

        {% if section.settings.home_collection != blank %}
          {% assign catalogue_collection = section.settings.home_collection %}

          {% if catalogue_collection.products_count > 0 %}
            <section class="hj-catalogue-group">
              <header class="hj-catalogue-group__header">
                <h2 class="hj-catalogue-group__heading">
                  {{ catalogue_collection.title }}
                </h2>

                <a
                  href="{{ catalogue_collection.url }}"
                  class="hj-catalogue-group__link"
                >
                  View collection
                  <span aria-hidden="true">→</span>
                </a>
              </header>

              <div class="hj-catalogue__grid">
                {% for product in catalogue_collection.products %}
                  <article class="hj-catalogue-card">
                    <a
                      href="{{ product.url }}"
                      class="hj-catalogue-card__link"
                      aria-label="{{ product.title | escape }}"
                    >
                      <div class="hj-catalogue-card__media">
                        {% if product.featured_image != blank %}
                          {{
                            product.featured_image
                            | image_url: width: 1200
                            | image_tag:
                              loading: 'lazy',
                              widths: '480, 720, 960, 1200',
                              sizes: '(min-width: 1200px) 25vw, (min-width: 750px) 33vw, 50vw',
                              class: 'hj-catalogue-card__image',
                              alt: product.featured_image.alt
                            | default: product.title
                            | escape
                          }}
                        {% else %}
                          {{ 'product-1' | placeholder_svg_tag: 'hj-catalogue-card__placeholder' }}
                        {% endif %}
                      </div>

                      <div class="hj-catalogue-card__content">
                        <h3 class="hj-catalogue-card__title">
                          {{ product.title | escape }}
                        </h3>

                        <span class="hj-catalogue-card__cta"> View details → </span>
                      </div>
                    </a>
                  </article>
                {% endfor %}
              </div>
            </section>
          {% endif %}
        {% endif %}

        {% comment %}
          CELEBRATIONS & LUXURY
        {% endcomment %}

        {% if section.settings.celebrations_collection != blank %}
          {% assign catalogue_collection = section.settings.celebrations_collection %}

          {% if catalogue_collection.products_count > 0 %}
            <section class="hj-catalogue-group">
              <header class="hj-catalogue-group__header">
                <h2 class="hj-catalogue-group__heading">
                  {{ catalogue_collection.title }}
                </h2>

                <a
                  href="{{ catalogue_collection.url }}"
                  class="hj-catalogue-group__link"
                >
                  View collection
                  <span aria-hidden="true">→</span>
                </a>
              </header>

              <div class="hj-catalogue__grid">
                {% for product in catalogue_collection.products %}
                  <article class="hj-catalogue-card">
                    <a
                      href="{{ product.url }}"
                      class="hj-catalogue-card__link"
                      aria-label="{{ product.title | escape }}"
                    >
                      <div class="hj-catalogue-card__media">
                        {% if product.featured_image != blank %}
                          {{
                            product.featured_image
                            | image_url: width: 1200
                            | image_tag:
                              loading: 'lazy',
                              widths: '480, 720, 960, 1200',
                              sizes: '(min-width: 1200px) 25vw, (min-width: 750px) 33vw, 50vw',
                              class: 'hj-catalogue-card__image',
                              alt: product.featured_image.alt
                            | default: product.title
                            | escape
                          }}
                        {% else %}
                          {{ 'product-1' | placeholder_svg_tag: 'hj-catalogue-card__placeholder' }}
                        {% endif %}
                      </div>

                      <div class="hj-catalogue-card__content">
                        <h3 class="hj-catalogue-card__title">
                          {{ product.title | escape }}
                        </h3>

                        <span class="hj-catalogue-card__cta"> View details → </span>
                      </div>
                    </a>
                  </article>
                {% endfor %}
              </div>
            </section>
          {% endif %}
        {% endif %}

        {% comment %}
          GOURMET & INDULGENCE
        {% endcomment %}

        {% if section.settings.gourmet_collection != blank %}
          {% assign catalogue_collection = section.settings.gourmet_collection %}

          {% if catalogue_collection.products_count > 0 %}
            <section class="hj-catalogue-group">
              <header class="hj-catalogue-group__header">
                <h2 class="hj-catalogue-group__heading">
                  {{ catalogue_collection.title }}
                </h2>

                <a
                  href="{{ catalogue_collection.url }}"
                  class="hj-catalogue-group__link"
                >
                  View collection
                  <span aria-hidden="true">→</span>
                </a>
              </header>

              <div class="hj-catalogue__grid">
                {% for product in catalogue_collection.products %}
                  <article class="hj-catalogue-card">
                    <a
                      href="{{ product.url }}"
                      class="hj-catalogue-card__link"
                      aria-label="{{ product.title | escape }}"
                    >
                      <div class="hj-catalogue-card__media">
                        {% if product.featured_image != blank %}
                          {{
                            product.featured_image
                            | image_url: width: 1200
                            | image_tag:
                              loading: 'lazy',
                              widths: '480, 720, 960, 1200',
                              sizes: '(min-width: 1200px) 25vw, (min-width: 750px) 33vw, 50vw',
                              class: 'hj-catalogue-card__image',
                              alt: product.featured_image.alt
                            | default: product.title
                            | escape
                          }}
                        {% else %}
                          {{ 'product-1' | placeholder_svg_tag: 'hj-catalogue-card__placeholder' }}
                        {% endif %}
                      </div>

                      <div class="hj-catalogue-card__content">
                        <h3 class="hj-catalogue-card__title">
                          {{ product.title | escape }}
                        </h3>

                        <span class="hj-catalogue-card__cta"> View details → </span>
                      </div>
                    </a>
                  </article>
                {% endfor %}
              </div>
            </section>
          {% endif %}
        {% endif %}

        {% comment %}
          SEASONAL COLLECTIONS
        {% endcomment %}

        {% if section.settings.seasonal_collection != blank %}
          {% assign catalogue_collection = section.settings.seasonal_collection %}

          {% if catalogue_collection.products_count > 0 %}
            <section class="hj-catalogue-group hj-catalogue-group--seasonal">
              <header class="hj-catalogue-group__header">
                <div>
                  <p class="hj-catalogue-group__eyebrow">SEASONAL GIFTING</p>

                  <h2 class="hj-catalogue-group__heading">
                    {{ catalogue_collection.title }}
                  </h2>
                </div>

                <a
                  href="{{ catalogue_collection.url }}"
                  class="hj-catalogue-group__link"
                >
                  View collection
                  <span aria-hidden="true">→</span>
                </a>
              </header>

              <div class="hj-catalogue__grid">
                {% for product in catalogue_collection.products %}
                  <article class="hj-catalogue-card">
                    <a
                      href="{{ product.url }}"
                      class="hj-catalogue-card__link"
                      aria-label="{{ product.title | escape }}"
                    >
                      <div class="hj-catalogue-card__media">
                        {% if product.featured_image != blank %}
                          {{
                            product.featured_image
                            | image_url: width: 1200
                            | image_tag:
                              loading: 'lazy',
                              widths: '480, 720, 960, 1200',
                              sizes: '(min-width: 1200px) 25vw, (min-width: 750px) 33vw, 50vw',
                              class: 'hj-catalogue-card__image',
                              alt: product.featured_image.alt
                            | default: product.title
                            | escape
                          }}
                        {% else %}
                          {{ 'product-1' | placeholder_svg_tag: 'hj-catalogue-card__placeholder' }}
                        {% endif %}
                      </div>

                      <div class="hj-catalogue-card__content">
                        <h3 class="hj-catalogue-card__title">
                          {{ product.title | escape }}
                        </h3>

                        <span class="hj-catalogue-card__cta"> View details → </span>
                      </div>
                    </a>
                  </article>
                {% endfor %}
              </div>
            </section>
          {% endif %}
        {% endif %}
      </div>

    {% elsif request.design_mode %}
      <div class="hj-catalogue__empty">
        <p>Select at least one product collection.</p>
      </div>
    {% endif %}
  </div>

  <div class="hj-collection-cta">
    <div class="hj-collection-cta__inner">
      <p class="hj-collection-cta__eyebrow">FOR BUSINESS & CUSTOM GIFTING</p>

      <h2 class="hj-collection-cta__heading">Looking for something more personal?</h2>

      <p class="hj-collection-cta__text">
        Create thoughtful gifts for clients, teams, settlements and special business occasions.
      </p>

      <a
        href="mailto:admin@hamperjunction.com.au"
        class="hj-collection-cta__button"
      >
        Enquire about corporate gifting →
      </a>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "HJ Hampers Catalogue",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "OUR HAMPERS"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Thoughtfully curated gifting."
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>Explore beautifully presented hampers for celebrations, new homes, milestones and meaningful moments.</p>"
    },
    {
      "type": "collection",
      "id": "home_collection",
      "label": "Home & Housewarming collection"
    },
    {
      "type": "collection",
      "id": "celebrations_collection",
      "label": "Celebrations & Luxury collection"
    },
    {
      "type": "collection",
      "id": "gourmet_collection",
      "label": "Gourmet & Indulgence collection"
    },
    {
      "type": "collection",
      "id": "seasonal_collection",
      "label": "Seasonal collection"
    }
  ],
  "presets": [
    {
      "name": "HJ Hampers Catalogue"
    }
  ]
}
{% endschema %}
