<section class="hj-about">
  <div class="page-width">
    <header class="hj-about__hero">
      <p class="hj-about__eyebrow">
        {{ section.settings.eyebrow }}
      </p>

      <h1 class="hj-about__heading">
        {{ section.settings.heading }}
      </h1>

      {% if section.settings.intro != blank %}
        <div class="hj-about__intro rte">
          {{ section.settings.intro }}
        </div>
      {% endif %}
    </header>

    {% if section.settings.hero_image != blank %}
      <div class="hj-about__hero-image">
        {{
          section.settings.hero_image
          | image_url: width: 2400
          | image_tag:
            loading: 'eager',
            widths: '900, 1200, 1600, 2000, 2400',
            sizes: '100vw',
            alt: section.settings.hero_image.alt
          | default: section.settings.heading
        }}
      </div>
    {% endif %}

    <div class="hj-about__story">
      <div class="hj-about__story-content">
        <p class="hj-about__eyebrow">
          {{ section.settings.story_eyebrow }}
        </p>

        <h2 class="hj-about__subheading">
          {{ section.settings.story_heading }}
        </h2>

        {% if section.settings.story != blank %}
          <div class="hj-about__body rte">
            {{ section.settings.story }}
          </div>
        {% endif %}
      </div>

      {% if section.settings.story_image != blank %}
        <div class="hj-about__story-image">
          {{
            section.settings.story_image
            | image_url: width: 1600
            | image_tag:
              loading: 'lazy',
              widths: '600, 900, 1200, 1600',
              sizes: '(min-width: 990px) 50vw, 100vw',
              alt: section.settings.story_image.alt
            | default: section.settings.story_heading
          }}
        </div>
      {% endif %}
    </div>

    <div class="hj-about__beliefs">
      <div class="hj-about__beliefs-intro">
        <p class="hj-about__eyebrow">
          {{ section.settings.beliefs_eyebrow }}
        </p>

        <h2 class="hj-about__subheading">
          {{ section.settings.beliefs_heading }}
        </h2>
      </div>

      <div class="hj-about__beliefs-grid">
        {% for block in section.blocks %}
          <article class="hj-about__belief" {{ block.shopify_attributes }}>
            <span class="hj-about__belief-number"> 0{{ forloop.index }} </span>

            <h3 class="hj-about__belief-title">
              {{ block.settings.heading }}
            </h3>

            {% if block.settings.text != blank %}
              <div class="hj-about__belief-text rte">
                {{ block.settings.text }}
              </div>
            {% endif %}
          </article>
        {% endfor %}
      </div>
    </div>

    <div class="hj-about__purpose">
      <div class="hj-about__purpose-content">
        <p class="hj-about__eyebrow">
          {{ section.settings.purpose_eyebrow }}
        </p>

        <h2 class="hj-about__subheading">
          {{ section.settings.purpose_heading }}
        </h2>

        {% if section.settings.purpose_text != blank %}
          <div class="hj-about__body rte">
            {{ section.settings.purpose_text }}
          </div>
        {% endif %}
      </div>

      {% if section.settings.purpose_image != blank %}
        <div class="hj-about__purpose-image">
          {{
            section.settings.purpose_image
            | image_url: width: 1600
            | image_tag:
              loading: 'lazy',
              widths: '600, 900, 1200, 1600',
              sizes: '(min-width: 990px) 50vw, 100vw',
              alt: section.settings.purpose_image.alt
            | default: section.settings.purpose_heading
          }}
        </div>
      {% endif %}
    </div>

    <div class="hj-about__corporate">
      <div>
        <p class="hj-about__eyebrow">
          {{ section.settings.corporate_eyebrow }}
        </p>

        <h2 class="hj-about__corporate-heading">
          {{ section.settings.corporate_heading }}
        </h2>
      </div>

      <div class="hj-about__corporate-action">
        {% if section.settings.corporate_text != blank %}
          <div class="hj-about__corporate-text rte">
            {{ section.settings.corporate_text }}
          </div>
        {% endif %}

        <a
          href="{{ section.settings.corporate_link }}"
          class="hj-about__button"
        >
          {{ section.settings.corporate_button }}
          <span aria-hidden="true">→</span>
        </a>
      </div>
    </div>

    <div class="hj-about__closing">
      <p class="hj-about__eyebrow">
        {{ section.settings.closing_eyebrow }}
      </p>

      <h2 class="hj-about__closing-heading">
        {{ section.settings.closing_heading }}
      </h2>

      <a
        href="{{ section.settings.closing_link }}"
        class="hj-about__closing-button"
      >
        {{ section.settings.closing_button }}
        <span aria-hidden="true">→</span>
      </a>
    </div>
  </div>
</section>

