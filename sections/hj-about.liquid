{{ 'hj-custom.css' | asset_url | stylesheet_tag }}

<section class="hj-about">
  {%- comment -%}
    1. HERO
    Image retained with Shopify image picker.
  {%- endcomment -%}
  <div class="hj-about__hero">
    <div class="hj-about__hero-content">
      <p class="hj-about__eyebrow">OUR STORY</p>

      <h1 class="hj-about__hero-heading">Thoughtful gifting, beautifully brought to life.</h1>

      <div class="hj-about__hero-intro">
        <p>
          At <strong>Hamper Junction</strong>, we believe the best gifts do more than look beautiful —
          <strong>they make people feel remembered.</strong>
        </p>
      </div>
    </div>

    <div class="hj-about__hero-image">
      {% if section.settings.hero_image != blank %}
        {{
          section.settings.hero_image
          | image_url: width: 1800
          | image_tag:
            loading: 'eager',
            widths: '750, 1000, 1200, 1500, 1800',
            sizes: '(min-width: 990px) 50vw, 100vw',
            class: 'hj-about__image',
            alt: section.settings.hero_image.alt
        }}
      {% else %}
        <div class="hj-about__image-placeholder">
          <span>About hero image</span>
        </div>
      {% endif %}
    </div>
  </div>

  {%- comment -%}
    2. OUR STORY
    Image removed.
    Text centred.
  {%- endcomment -%}
  <div class="hj-about__story">
    <div class="hj-about__story-content">
      <p class="hj-about__eyebrow">OUR STORY</p>

      <div class="hj-about__body">
        <h2 class="hj-about__subheading">
          Our story began with something simple: a love for finding the perfect gift.
        </h2>

        <p>
          Long before Hamper Junction had a name, <strong>Amruta and Pratik</strong>, two IT professionals living in
          Sydney, found themselves wandering through markets, boutiques and local stores, always searching for something
          special to give the people they cared about.
        </p>

        <p>
          We loved the excitement of discovering something unique. We loved putting different pieces together. And most
          of all, we loved seeing the moment someone opened a gift and knew that real thought had gone into it.
        </p>

        <p>Over time, what started as a passion became something more.</p>
      </div>

      <h2 class="hj-about__subheading">From a passion for gifting to Hamper Junction</h2>

      <div class="hj-about__body">
        <p>
          Friends and family began noticing the care we put into every gift we created. The thoughtful combinations. The
          little details. The way everything was presented.
        </p>

        <p>
          They encouraged us to turn that passion into something bigger. And so,
          <strong>Hamper Junction was born.</strong> We set out with a simple belief:
        </p>

        <p>
          <strong>Gifting should feel personal, thoughtful and genuinely special.</strong>
          Not something chosen at the last minute. Not just another box of products. But a carefully curated experience
          that tells someone,
          <strong>“I thought of you.”</strong>
        </p>
      </div>
    </div>
  </div>

  {%- comment -%}
    3. TWO PEOPLE
    Leave as-is.
  {%- endcomment -%}
  <div class="hj-about__people">
    <div class="hj-about__people-header">
      <p class="hj-about__eyebrow">TWO PEOPLE. ONE SHARED PASSION.</p>

      <div class="hj-about__people-intro">
        <p>Hamper Junction is a reflection of both of us.</p>
      </div>
    </div>

    <div class="hj-about__people-grid">
      <article class="hj-about__person">
        <h2 class="hj-about__person-name">Amruta</h2>

        <div class="hj-about__body">
          <p>
            <strong>Amruta</strong> brings the creative heart — an eye for beautiful presentation, a love for detail and
            a natural instinct for pairing products that complement each other and tell a story.
          </p>
        </div>
      </article>

      <article class="hj-about__person">
        <h2 class="hj-about__person-name">Pratik</h2>

        <div class="hj-about__body">
          <p>
            <strong>Pratik</strong> brings the business mind — combining marketing, strategy and structure to turn
            creative ideas into memorable gifting experiences.
          </p>
        </div>
      </article>
    </div>

    <div class="hj-about__people-followup">
      <div class="hj-about__body">
        <p>Together, we bring those strengths into every hamper we create.</p>

        <p>
          From the products we select to the way each hamper is presented,
          <strong>every detail has a purpose.</strong>
        </p>
      </div>
    </div>
  </div>

  {%- comment -%}
    4. THOUGHTFULLY CURATED
    Image retained with Shopify image picker.
  {%- endcomment -%}
  <div class="hj-about__curated">
    <div class="hj-about__curated-content">
      <p class="hj-about__eyebrow">THOUGHTFULLY CURATED. PROUDLY AUSTRALIAN.</p>

      <h2 class="hj-about__section-heading">Thoughtfully curated. Proudly Australian.</h2>

      <div class="hj-about__body">
        <p>We believe great gifting starts with great products.</p>

        <p>
          That’s why we look for
          <strong>unique products, beautiful finds and locally sourced Australian items</strong>, with a focus on
          supporting small makers and businesses wherever we can.
        </p>

        <p>
          We carefully consider how each item works within the overall hamper — creating combinations that feel
          <strong>warm, elegant, meaningful and personal.</strong>
        </p>

        <p>Because to us, a hamper isn’t simply a collection of products.</p>

        <p class="hj-about__standout">
          <strong>It’s a collection of moments.</strong>
        </p>

        <div class="hj-about__moments">
          <p>A thank-you.</p>
          <p>A congratulations.</p>
          <p>A warm welcome.</p>
          <p>A celebration.</p>
          <p>A little reminder that someone is thinking of you.</p>
        </div>
      </div>
    </div>

    <div class="hj-about__curated-image">
      {% if section.settings.curated_image != blank %}
        {{
          section.settings.curated_image
          | image_url: width: 1800
          | image_tag:
            loading: 'lazy',
            widths: '750, 1000, 1200, 1500, 1800',
            sizes: '(min-width: 990px) 50vw, 100vw',
            class: 'hj-about__image',
            alt: section.settings.curated_image.alt
        }}

      {% else %}
        <div class="hj-about__image-placeholder">
          <span>Australian gifting image</span>
        </div>
      {% endif %}
    </div>
  </div>

  {%- comment -%}
    5. MORE THAN A HAMPER
    Text centred.
  {%- endcomment -%}
  <div class="hj-about__more">
    <div class="hj-about__more-inner">
      <p class="hj-about__eyebrow">MORE THAN A HAMPER</p>

      <h2 class="hj-about__section-heading">More than a hamper</h2>

      <div class="hj-about__body">
        <p>
          As Hamper Junction grows, our purpose remains the same:
          <strong>to make gifting easier, more thoughtful and more memorable.</strong>
        </p>

        <p>
          We’re continually discovering new products, creating new combinations and finding better ways to turn ordinary
          gifting moments into something extraordinary.
        </p>

        <p>We’re still a small business, and that’s something we’re proud of.</p>

        <p>
          It means every hamper still receives the same care and attention that inspired us to start in the first place.
        </p>
      </div>
    </div>
  </div>

  {%- comment -%}
    6. CLOSING
    Leave as-is.
  {%- endcomment -%}
  <div class="hj-about__closing">
    <div class="hj-about__closing-inner">
      <p>Because behind every hamper is a simple idea:</p>

      <h2>
        <strong>The best gifts aren’t just opened.</strong><br>
        <strong>They’re remembered.</strong>
      </h2>

      <p class="hj-about__closing-welcome">Welcome to Hamper Junction.</p>
    </div>
  </div>
</section>

<style>
  /*
   * HJ ABOUT — TARGETED LAYOUT OVERRIDES
   * These rules only affect the About section.
   */

  /* --------------------------------------------------
     1. HERO IMAGE
     -------------------------------------------------- */

  .hj-about__hero-image {
    overflow: hidden;
  }

  .hj-about__hero-image .hj-about__image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* --------------------------------------------------
     2. OUR STORY — CENTRED
     -------------------------------------------------- */

  .hj-about__story {
    display: block;
  }

  .hj-about__story-content {
    width: min(100%, 760px);
    margin-left: auto;
    margin-right: auto;
    text-align: center;
  }

  .hj-about__story-content .hj-about__body {
    margin-left: auto;
    margin-right: auto;
  }

  /* --------------------------------------------------
     4. CURATED IMAGE
     Prevent the image from becoming excessively tall.
     -------------------------------------------------- */

  .hj-about__curated-image {
    align-self: start;
    width: 100%;
    aspect-ratio: 1 / 1;
    overflow: hidden;
  }

  .hj-about__curated-image .hj-about__image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .hj-about__curated-image .hj-about__image-placeholder {
    width: 100%;
    height: 100%;
  }

  /* --------------------------------------------------
     5. MORE THAN A HAMPER — CENTRED
     -------------------------------------------------- */

  .hj-about__more-inner {
    text-align: center;
    margin-left: auto;
    margin-right: auto;
  }

  .hj-about__more-inner .hj-about__body {
    margin-left: auto;
    margin-right: auto;
  }

  /* --------------------------------------------------
     MOBILE
     -------------------------------------------------- */

  @media screen and (max-width: 749px) {
    .hj-about__hero-image {
      min-height: 320px;
    }

    .hj-about__hero-image .hj-about__image {
      min-height: 320px;
    }

    .hj-about__story-content {
      width: 100%;
      text-align: center;
    }

    .hj-about__curated-image {
      aspect-ratio: 4 / 3;
    }

    .hj-about__more-inner {
      text-align: center;
    }
  }
</style>

{% schema %}
{
  "name": "HJ About",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "image_picker",
      "id": "hero_image",
      "label": "About hero image"
    },
    {
      "type": "image_picker",
      "id": "curated_image",
      "label": "Australian gifting image"
    }
  ],
  "presets": [
    {
      "name": "HJ About"
    }
  ]
}
{% endschema %}
