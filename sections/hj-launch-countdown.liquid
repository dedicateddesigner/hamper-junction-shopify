        },
        {
          "value": "Australia/Adelaide",
          "label": "Adelaide — Australia"
        },
        {
          "value": "Australia/Perth",
          "label": "Perth — Australia"
        },
        {
          "value": "Asia/Kolkata",
          "label": "India"
        },
        {
          "value": "Pacific/Auckland",
          "label": "Auckland — New Zealand"
        },
        {
          "value": "Asia/Singapore",
          "label": "Singapore"
        },
        {
          "value": "Asia/Dubai",
          "label": "Dubai — UAE"
        },
        {
