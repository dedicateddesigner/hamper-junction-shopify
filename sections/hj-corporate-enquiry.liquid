<section
  id="hj-corporate-enquiry-{{ section.id }}"
  class="hj-corporate-enquiry"
>
  <div class="page-width">
    <div class="hj-corporate-enquiry__layout">
      <!-- Intro -->
      <div class="hj-corporate-enquiry__intro">
        {% if section.settings.eyebrow != blank %}
          <p class="hj-corporate-enquiry__eyebrow">
            {{ section.settings.eyebrow }}
          </p>
        {% endif %}

        {% if section.settings.heading != blank %}
          <h1 class="hj-corporate-enquiry__heading">
            {{ section.settings.heading }}
          </h1>
        {% endif %}

        {% if section.settings.description != blank %}
          <div class="hj-corporate-enquiry__description rte">
            {{ section.settings.description }}
          </div>
        {% endif %}

        <div class="hj-corporate-enquiry__details">
          <div class="hj-corporate-enquiry__detail">
            <span class="hj-corporate-enquiry__detail-label"> CUSTOMISATION </span>
            <p>Custom ribbons, branded logo cards and personalised message cards.</p>
          </div>

          <div class="hj-corporate-enquiry__detail">
            <span class="hj-corporate-enquiry__detail-label"> CORPORATE ORDERS </span>
            <p>Thoughtful gifting for clients, teams, settlements and special occasions.</p>
          </div>

          <div class="hj-corporate-enquiry__detail">
            <span class="hj-corporate-enquiry__detail-label"> BULK GIFTING </span>
            <p>Tell us what you need and we'll help create the right gifting solution.</p>
          </div>
        </div>
      </div>

      <!-- Form -->
      <div class="hj-corporate-enquiry__form-wrapper">
        {% form 'contact', id: 'HJCorporateEnquiryForm' %}
          {% if form.posted_successfully? %}
            <div class="hj-corporate-enquiry__success" role="status">
              <p class="hj-corporate-enquiry__success-heading">Thank you for your enquiry.</p>

              <p>Our team will be in touch shortly to discuss your gifting requirements.</p>
            </div>
          {% endif %}

          {% if form.errors %}
            <div class="hj-corporate-enquiry__errors" role="alert">
              {{ form.errors | default_errors }}
            </div>
          {% endif %}

          <div class="hj-form-field">
            <label for="HJCorporateName"> Full name <span>*</span> </label>

            <input
              type="text"
              id="HJCorporateName"
              name="contact[name]"
              autocomplete="name"
              required
              placeholder="Your full name"
              value="{{ form.name }}"
            >
          </div>

          <div class="hj-form-field">
            <label for="HJCorporateCompany"> Company / organisation <span>*</span> </label>

            <input
              type="text"
              id="HJCorporateCompany"
              name="contact[company]"
              autocomplete="organization"
              required
              placeholder="Company name"
            >
          </div>

          <div class="hj-form-row">
            <div class="hj-form-field">
              <label for="HJCorporateEmail"> Work email <span>*</span> </label>

              <input
                type="email"
                id="HJCorporateEmail"
                name="contact[email]"
                autocomplete="email"
                required
                placeholder="you@company.com"
                value="{{ form.email }}"
              >
            </div>

            <div class="hj-form-field">
              <label for="HJCorporatePhone"> Phone number </label>

              <input
                type="tel"
                id="HJCorporatePhone"
                name="contact[phone]"
                autocomplete="tel"
                placeholder="+61"
                value="{{ form.phone }}"
              >
            </div>
          </div>

          <div class="hj-form-row">
            <div class="hj-form-field">
              <label for="HJCorporateOccasion"> What are you gifting for? <span>*</span> </label>

              <select
                id="HJCorporateOccasion"
                name="contact[Gift occasion]"
                required
              >
                <option value="" selected disabled>Select an occasion</option>

                <option value="Client appreciation">Client appreciation</option>

                <option value="Employee gifting">Employee gifting</option>

                <option value="Settlement gifts">Settlement gifts</option>

                <option value="Corporate event">Corporate event</option>

                <option value="Celebration">Celebration</option>

                <option value="Other">Other</option>
              </select>
            </div>

            <div class="hj-form-field">
              <label for="HJCorporateQuantity"> Approximate quantity <span>*</span> </label>

              <select
                id="HJCorporateQuantity"
                name="contact[Approximate quantity]"
                required
              >
                <option value="" selected disabled>Select quantity</option>

                <option value="1–10">1–10</option>

                <option value="11–25">11–25</option>

                <option value="26–50">26–50</option>

                <option value="51–100">51–100</option>

                <option value="100+">100+</option>
              </select>
            </div>
          </div>

          <div class="hj-form-field">
            <label for="HJCorporateDate"> Preferred delivery date </label>

            <input
              type="date"
              id="HJCorporateDate"
              name="contact[Preferred delivery date]"
            >
          </div>

          <div class="hj-form-field">
            <label for="HJCorporateMessage"> Tell us about your gifting requirements </label>

            <textarea
              id="HJCorporateMessage"
              name="contact[body]"
              rows="6"
              placeholder="Tell us about your hampers, quantities, delivery requirements, branding or personalisation."
            >{{ form.body }}</textarea>
          </div>

          <button
            type="submit"
            class="hj-corporate-enquiry__button"
          >
            {{ section.settings.button_text }}
            <span aria-hidden="true">→</span>
          </button>

          <p class="hj-corporate-enquiry__note">
            Prefer email?
            <a href="mailto:{{ section.settings.enquiry_email }}">
              {{ section.settings.enquiry_email }}
            </a>
          </p>
        {% endform %}
      </div>
    </div>
  </div>
</section>

{% stylesheet %}
  .hj-corporate-enquiry {
    background: #f7f5f1;
    padding: 8rem 0 10rem;
  }

  .hj-corporate-enquiry__layout {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    gap: 8rem;
    align-items: start;
  }

  .hj-corporate-enquiry__intro {
    position: sticky;
    top: 4rem;
  }

  .hj-corporate-enquiry__eyebrow {
    margin: 0 0 1.6rem;
    color: #6e6a65;
    font-size: 1.1rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .hj-corporate-enquiry__heading {
    margin: 0;
    color: #111111;
    font-size: clamp(4rem, 5.5vw, 7rem);
    line-height: 0.96;
    letter-spacing: -0.045em;
    font-weight: 500;
  }

  .hj-corporate-enquiry__description {
    max-width: 600px;
    margin-top: 2.8rem;
    color: #6e6a65;
    font-size: 1.6rem;
    line-height: 1.65;
  }

  .hj-corporate-enquiry__details {
    margin-top: 5rem;
    border-top: 1px solid #d9d5ce;
  }

  .hj-corporate-enquiry__detail {
    padding: 2rem 0;
    border-bottom: 1px solid #d9d5ce;
  }

  .hj-corporate-enquiry__detail-label {
    display: block;
    margin-bottom: 0.8rem;
    color: #111111;
    font-size: 1rem;
    letter-spacing: 0.14em;
  }

  .hj-corporate-enquiry__detail p {
    max-width: 500px;
    margin: 0;
    color: #6e6a65;
    font-size: 1.35rem;
    line-height: 1.55;
  }

  .hj-corporate-enquiry__form-wrapper {
    padding: 4rem;
    background: #ffffff;
  }

  .hj-form-field {
    margin-bottom: 2.4rem;
  }

  .hj-form-field label {
    display: block;
    margin-bottom: 0.9rem;
    color: #111111;
    font-size: 1.15rem;
    font-weight: 500;
  }

  .hj-form-field label span {
    color: #6e6a65;
  }

  .hj-form-field input,
  .hj-form-field select,
  .hj-form-field textarea {
    display: block;
    width: 100%;
    min-height: 5.2rem;
    padding: 1.4rem 1.5rem;
    border: 1px solid #d5d1ca;
    border-radius: 0;
    background: #ffffff;
    color: #111111;
    font: inherit;
    font-size: 1.3rem;
    transition: border-color 200ms ease, box-shadow 200ms ease;
    box-sizing: border-box;
  }

  .hj-form-field textarea {
    min-height: 14rem;
    resize: vertical;
  }

  .hj-form-field input:focus,
  .hj-form-field select:focus,
  .hj-form-field textarea:focus {
    outline: none;
    border-color: #111111;
    box-shadow: 0 0 0 1px #111111;
  }

  .hj-form-row {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.6rem;
  }

  .hj-corporate-enquiry__button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 1.2rem;
    width: 100%;
    min-height: 5.6rem;
    padding: 1.5rem 2rem;
    border: 1px solid #000000;
    background: #000000;
    color: #ffffff;
    cursor: pointer;
    font: inherit;
    font-size: 1.15rem;
    letter-spacing: 0.04em;
    transition: background-color 200ms ease, color 200ms ease;
  }

  .hj-corporate-enquiry__button:hover {
    background: #ffffff;
    color: #000000;
  }

  .hj-corporate-enquiry__note {
    margin: 1.8rem 0 0;
    color: #6e6a65;
    font-size: 1.15rem;
    text-align: center;
  }

  .hj-corporate-enquiry__note a {
    color: #111111;
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .hj-corporate-enquiry__success {
    margin-bottom: 3rem;
    padding: 2rem;
    border: 1px solid #d5d1ca;
    background: #f7f5f1;
    color: #111111;
  }

  .hj-corporate-enquiry__success-heading {
    margin: 0 0 0.8rem;
    font-size: 1.4rem;
    font-weight: 500;
  }

  .hj-corporate-enquiry__success p:last-child {
    margin: 0;
    color: #6e6a65;
  }

  .hj-corporate-enquiry__errors {
    margin-bottom: 2rem;
    padding: 1.5rem;
    border: 1px solid #111111;
    color: #111111;
  }

  @media screen and (max-width: 989px) {
    .hj-corporate-enquiry__layout {
      grid-template-columns: 1fr;
      gap: 5rem;
    }

    .hj-corporate-enquiry__intro {
      position: static;
    }
  }

  @media screen and (max-width: 749px) {
    .hj-corporate-enquiry {
      padding: 5rem 0 6rem;
    }

    .hj-corporate-enquiry__heading {
      font-size: clamp(3.6rem, 12vw, 5rem);
    }

    .hj-corporate-enquiry__description {
      font-size: 1.4rem;
    }

    .hj-form-row {
      grid-template-columns: 1fr;
      gap: 0;
    }

    .hj-corporate-enquiry__form-wrapper {
      padding: 2.4rem 1.8rem;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "HJ Corporate Enquiry",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "CORPORATE & CUSTOM GIFTING"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Thoughtful gifting, made personal."
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>Whether you're gifting clients, welcoming new homeowners or celebrating your team, we'll help create a thoughtful gifting experience tailored to the occasion.</p>"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button text",
      "default": "Request a gifting consultation"
    },
    {
      "type": "text",
      "id": "enquiry_email",
      "label": "Enquiry email",
      "default": "admin@hamperjunction.com.au"
    }
  ]
}
{% endschema %}
