<section
  id="hj-featured-hampers-{{ section.id }}"
  class="hj-featured-section"
>
  <div class="page-width">
    <div class="hj-featured-header">
      {% if section.settings.eyebrow != blank %}
        <p class="hj-featured-eyebrow">
          {{ section.settings.eyebrow }}
        </p>
      {% endif %}

      {% if section.settings.heading != blank %}
        <h2 class="hj-featured-heading">
          {{ section.settings.heading }}
        </h2>
      {% endif %}

      {% if section.settings.description != blank %}
        <div class="hj-featured-description rte">
          {{ section.settings.description }}
        </div>
      {% endif %}
    </div>

    {% if section.settings.collection != blank %}
      <div
        class="hj-featured-grid hj-featured-grid--{{ section.settings.products_to_show }}"
      >
        {% for product in section.settings.collection.products limit: section.settings.products_to_show %}
          <article class="hj-featured-product">
            <a
              href="{{ product.url }}"
              class="hj-featured-product__link"
              aria-label="{{ product.title | escape }}"
            >
              <div class="hj-featured-product__media">
                {% if product.featured_image != blank %}
                  {{
                    product.featured_image
                    | image_url: width: 1200
                    | image_tag:
                      loading: 'lazy',
                      widths: '480, 720, 960, 1200',
                      sizes: '(min-width: 1200px) 25vw, (min-width: 750px) 50vw, 90vw',
                      class: 'hj-featured-product__image',
                      alt: product.featured_image.alt
                    | default: product.title
                  }}
                {% else %}
                  <div class="hj-featured-product__placeholder">
                    {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
                  </div>
                {% endif %}
              </div>

              <div class="hj-featured-product__details">
                <h3 class="hj-featured-product__title">
                  {{ product.title }}
                </h3>

                <div class="hj-featured-product__bottom">
                  <span class="hj-featured-product__price">
                    {{ product.price | money }}
                  </span>

                  <span class="hj-featured-product__cta"> View hamper → </span>
                </div>
              </div>
            </a>
          </article>
        {% endfor %}
      </div>

      {% if section.settings.show_view_all %}
        <div class="hj-featured-view-all">
          <a
            href="{{ section.settings.collection.url }}"
            class="button hj-featured-view-all__button"
          >
            {{ section.settings.view_all_text }}
          </a>
        </div>
      {% endif %}

    {% elsif request.design_mode %}
      <div class="hj-featured-empty">
        <p>Select a collection for this section.</p>
      </div>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "HJ Featured Hampers",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "CURATED FOR EVERY OCCASION"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Featured Hampers"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>A considered collection of beautifully presented gifts.</p>"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Product collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "Products to show",
      "min": 4,
      "max": 6,
      "step": 1,
      "default": 4
    },
    {
      "type": "checkbox",
      "id": "show_view_all",
      "label": "Show view all button",
      "default": true
    },
    {
      "type": "text",
      "id": "view_all_text",
      "label": "View all button text",
      "default": "View all hampers"
    }
  ],
  "presets": [
    {
      "name": "HJ Featured Hampers"
    }
  ]
}
{% endschema %}
