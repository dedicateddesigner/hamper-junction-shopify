{{ 'hj-custom.css' | asset_url | stylesheet_tag }}
{% comment %}
  Hamper Junction — Password Page Header
{% endcomment %}

<header class="hj-password-header">
  <div class="hj-password-header__inner">
    <!-- MOBILE MENU -->
    <details class="hj-password-header__mobile-menu">
      <summary
        class="hj-password-header__icon"
        aria-label="Open menu"
      >
        <span class="hj-password-header__hamburger" aria-hidden="true">
          <span></span>
          <span></span>
          <span></span>
        </span>
      </summary>

      <div class="hj-password-header__drawer">
        <nav aria-label="Mobile navigation">
          <ul>
            {% for link in linklists['main-menu'].links %}
              <li>
                <a href="{{ link.url }}">
                  {{ link.title }}
                </a>

                {% if link.links != blank %}
                  <ul>
                    {% for child_link in link.links %}
                      <li>
                        <a href="{{ child_link.url }}">
                          {{ child_link.title }}
                        </a>
                      </li>
                    {% endfor %}
                  </ul>
                {% endif %}
              </li>
            {% endfor %}
          </ul>
        </nav>
      </div>
    </details>

    <!-- LOGO -->
    <a
      href="{{ routes.root_url }}"
      class="hj-password-header__logo-link"
      aria-label="{{ shop.name | escape }}"
    >
      <img
        src="{{ 'hamper-junction-logo-white.svg' | asset_url }}"
        class="hj-password-header__logo"
        width="220"
        height="86"
        alt="{{ shop.name | escape }}"
      >
    </a>

    <!-- DESKTOP NAV -->
    <nav
      class="hj-password-header__nav"
      aria-label="Main navigation"
    >
      {% for link in linklists['main-menu'].links %}
        <a href="{{ link.url }}">
          {{ link.title }}
        </a>
      {% endfor %}
    </nav>

    <!-- ACTIONS -->
    <div class="hj-password-header__actions">
      <a
        href="{{ routes.search_url }}"
        class="hj-password-header__icon"
        aria-label="Search"
      >
        <span class="svg-wrapper">
          {{ 'icon-search.svg' | inline_asset_content }}
        </span>
      </a>

      <a
        href="{{ routes.cart_url }}"
        class="hj-password-header__icon"
        aria-label="Cart"
      >
        <span class="svg-wrapper">
          {% if cart == empty %}
            {{ 'icon-cart-empty.svg' | inline_asset_content }}
          {% else %}
            {{ 'icon-cart.svg' | inline_asset_content }}
          {% endif %}
        </span>

        {% if cart != empty %}
          <span class="hj-password-header__cart-count">
            {{ cart.item_count }}
          </span>
        {% endif %}
      </a>

      <!-- PASSWORD LOGIN -->
      <password-modal>
        <details class="hj-password-header__password">
          <summary>
            <span class="svg-wrapper">
              {{ 'icon-padlock.svg' | inline_asset_content }}
            </span>
            <span>Enter using password</span>
          </summary>

          <div
            class="hj-password-header__password-modal"
            role="dialog"
            aria-modal="true"
          >
            <div class="hj-password-header__password-content">
              <button
                type="button"
                class="hj-password-header__password-close"
                aria-label="Close"
              >
                <span class="svg-wrapper">
                  {{ 'icon-close.svg' | inline_asset_content }}
                </span>
              </button>

              <h2>Enter store password</h2>

              {% form 'storefront_password', class: 'password-form' %}
                <div class="field">
                  <input
                    type="password"
                    name="password"
                    id="Password"
                    class="field__input"
                    autocomplete="current-password"
                    placeholder="Password"
                  >
                  <label
                    class="field__label"
                    for="Password"
                  >
                    Password
                  </label>
                </div>

                {% if form.errors %}
                  <div class="form__message" role="alert">
                    {{ 'general.password_page.login_form_error' | t }}
                  </div>
                {% endif %}

                <button
                  name="commit"
                  class="button"
                >
                  Enter
                </button>
              {% endform %}
            </div>
          </div>
        </details>
      </password-modal>
    </div>
  </div>
</header>

{% schema %}
{
  "name": "HJ Password Header",
  "settings": []
}
{% endschema %}
