<section
  id="hj-social-proof-{{ section.id }}"
  class="hj-social-section"
>
  <div class="page-width">
    <div class="hj-social-header">
      {% if section.settings.eyebrow != blank %}
        <p class="hj-social-eyebrow">
          {{ section.settings.eyebrow }}
        </p>
      {% endif %}

      {% if section.settings.heading != blank %}
        <h2 class="hj-social-heading">
          {{ section.settings.heading }}
        </h2>
      {% endif %}

      {% if section.settings.description != blank %}
        <div class="hj-social-description rte">
          {{ section.settings.description }}
        </div>
      {% endif %}
    </div>

    <div class="hj-social-grid">
      {% for block in section.blocks %}
        <article
          class="hj-social-card"
          {{ block.shopify_attributes }}
        >
          {% if block.settings.link != blank %}
            <a
              href="{{ block.settings.link }}"
              class="hj-social-card__link"
              aria-label="{{ block.settings.caption | default: 'View Hamper Junction video' | escape }}"
              {% if block.settings.open_new_tab %}
                target="_blank"
                rel="noopener noreferrer"
              {% endif %}
            >
          {% endif %}

          <div class="hj-social-card__media">
            {% if block.settings.video != blank %}
              {{
                block.settings.video
                | video_tag:
                  autoplay: true,
                  loop: true,
                  muted: true,
                  controls: false,
                  playsinline: true,
                  image_size: '900x'
              }}

            {% elsif block.settings.image != blank %}
              {{
                block.settings.image
                | image_url: width: 900
                | image_tag:
                  loading: 'lazy',
                  widths: '480, 720, 900',
                  sizes: '(min-width: 1200px) 25vw, (min-width: 750px) 33vw, 82vw',
                  class: 'hj-social-card__image',
                  alt: block.settings.image.alt
                | default: block.settings.caption
              }}

            {% else %}
              <div class="hj-social-card__placeholder">
                <span>Add video</span>
              </div>
            {% endif %}

            {% if block.settings.show_play_icon %}
              <span class="hj-social-card__play" aria-hidden="true">
                <span></span>
              </span>
            {% endif %}
          </div>

          {% if block.settings.caption != blank %}
            <div class="hj-social-card__caption">
              {{ block.settings.caption }}
            </div>
          {% endif %}

          {% if block.settings.link != blank %}
            </a>
          {% endif %}
        </article>
      {% endfor %}
    </div>

    {% if section.settings.instagram_url != blank %}
      <div class="hj-social-footer">
        <a
          href="{{ section.settings.instagram_url }}"
          class="hj-social-follow"
          target="_blank"
          rel="noopener noreferrer"
        >
          {{ section.settings.instagram_label }}
          <span aria-hidden="true">→</span>
        </a>
      </div>
    {% endif %}
  </div>
</section>

{% schema %}
{
  "name": "HJ Social Proof",
  "tag": "section",
  "class": "section",
  "max_blocks": 4,
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "SOCIAL PROOF"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "See Hamper Junction in action"
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>Thoughtful details, beautiful presentation and gifts made to be remembered.</p>"
    },
    {
      "type": "url",
      "id": "instagram_url",
      "label": "Instagram link"
    },
    {
      "type": "text",
      "id": "instagram_label",
      "label": "Instagram link label",
      "default": "Follow us on Instagram"
    }
  ],
  "blocks": [
    {
      "type": "video",
      "name": "Social video",
      "settings": [
        {
          "type": "video",
          "id": "video",
          "label": "Video"
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Fallback image",
          "info": "Shown when no video is selected or when the video cannot be played."
        },
        {
          "type": "text",
          "id": "caption",
          "label": "Caption"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        },
        {
          "type": "checkbox",
          "id": "open_new_tab",
          "label": "Open link in new tab",
          "default": true
        },
        {
          "type": "checkbox",
          "id": "show_play_icon",
          "label": "Show play icon",
          "default": true
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "HJ Social Proof",
      "blocks": [
        {
          "type": "video"
        },
        {
          "type": "video"
        },
        {
          "type": "video"
        },
        {
          "type": "video"
        }
      ]
    }
  ]
}
{% endschema %}
