{%- liquid
  assign seasonal_count = 0

  if section.settings.collection_1 != blank
    assign seasonal_count = seasonal_count | plus: 1
  endif

  if section.settings.collection_2 != blank
    assign seasonal_count = seasonal_count | plus: 1
  endif

  if section.settings.collection_3 != blank
    assign seasonal_count = seasonal_count | plus: 1
  endif

  if section.settings.collection_4 != blank
    assign seasonal_count = seasonal_count | plus: 1
  endif
-%}

{%- if seasonal_count > 0 -%}
  <section
    id="hj-seasonal-hampers-{{ section.id }}"
    class="hj-seasonal-section hj-seasonal-section--{{ seasonal_count }}"
  >
    <div class="page-width">
      <header class="hj-seasonal-header">
        {% if section.settings.eyebrow != blank %}
          <p class="hj-seasonal-eyebrow">
            {{ section.settings.eyebrow }}
          </p>
        {% endif %}

        {% if section.settings.heading != blank %}
          <h2 class="hj-seasonal-heading">
            {{ section.settings.heading }}
          </h2>
        {% endif %}

        {% if section.settings.description != blank %}
          <div class="hj-seasonal-description rte">
            {{ section.settings.description }}
          </div>
        {% endif %}
      </header>

      <div class="hj-seasonal-grid">
        {% for i in (1..4) %}
          {% liquid
            assign collection_key = 'collection_' | append: i
            assign seasonal_collection = section.settings[collection_key]
          %}

          {% if seasonal_collection != blank %}
            <article class="hj-seasonal-card">
              <a
                href="{{ seasonal_collection.url }}"
                class="hj-seasonal-card__link"
                aria-label="Explore {{ seasonal_collection.title | escape }}"
              >
                <div class="hj-seasonal-card__media">
                  {% if seasonal_collection.image != blank %}
                    {{
                      seasonal_collection.image
                      | image_url: width: 1800
                      | image_tag:
                        loading: 'lazy',
                        widths: '600, 900, 1200, 1500, 1800',
                        sizes: '(min-width: 1200px) 25vw, (min-width: 750px) 50vw, 100vw',
                        class: 'hj-seasonal-card__image',
                        alt: seasonal_collection.image.alt
                      | default: seasonal_collection.title
                    }}
                  {% else %}
                    <div class="hj-seasonal-card__placeholder">
                      <span>{{ seasonal_collection.title }}</span>
                    </div>
                  {% endif %}

                  <div class="hj-seasonal-card__overlay"></div>

                  <div class="hj-seasonal-card__content">
                    <h3 class="hj-seasonal-card__title">
                      {{ seasonal_collection.title }}
                    </h3>

                    <span class="hj-seasonal-card__cta">
                      Explore collection
                      <span aria-hidden="true">→</span>
                    </span>
                  </div>
                </div>
              </a>
            </article>
          {% endif %}
        {% endfor %}
      </div>
    </div>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "HJ Seasonal Hampers",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "SEASONAL GIFTING"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Celebrate the season beautifully."
    },
    {
      "type": "richtext",
      "id": "description",
      "label": "Description",
      "default": "<p>Thoughtfully curated hampers for celebrations, traditions and moments worth sharing.</p>"
    },
    {
      "type": "collection",
      "id": "collection_1",
      "label": "Seasonal collection 1"
    },
    {
      "type": "collection",
      "id": "collection_2",
      "label": "Seasonal collection 2"
    },
    {
      "type": "collection",
      "id": "collection_3",
      "label": "Seasonal collection 3"
    },
    {
      "type": "collection",
      "id": "collection_4",
      "label": "Seasonal collection 4"
    }
  ],
  "presets": [
    {
      "name": "HJ Seasonal Hampers"
    }
  ]
}
{% endschema %}
