{% comment %}
  Hamper Junction — Password Page Footer
{% endcomment %}

<footer class="hj-password-footer">
  <div class="hj-password-footer__main page-width">
    <!-- BRAND -->
    <div class="hj-password-footer__brand">
      <a
        href="{{ routes.root_url }}"
        class="hj-password-footer__logo-link"
        aria-label="{{ shop.name | escape }}"
      >
        <img
          src="{{ 'hamper-junction-logo-white.svg' | asset_url }}"
          class="hj-password-footer__logo"
          width="220"
          height="86"
          alt="{{ shop.name | escape }}"
          loading="lazy"
        >
      </a>

      <p class="hj-password-footer__tagline">Thoughtfully curated gifts, beautifully presented.</p>

      {% if settings.social_instagram_link != blank
        or settings.social_facebook_link != blank
        or settings.social_youtube_link != blank
        or settings.social_tiktok_link != blank
      %}
        <div class="hj-password-footer__social">
          {% render 'social-icons' %}
        </div>
      {% endif %}
    </div>

    <!-- QUICK LINKS -->
    <nav
      class="hj-password-footer__column"
      aria-label="Quick links"
    >
      <h2>Quick links</h2>

      <ul>
        {% for link in linklists.footer.links %}
          <li>
            <a href="{{ link.url }}">
              {{ link.title }}
            </a>
          </li>
        {% endfor %}
      </ul>
    </nav>

    <!-- POLICIES -->
    <nav
      class="hj-password-footer__column"
      aria-label="Policies"
    >
      <h2>Policies</h2>

      <ul>
        {% for link in linklists['policy-links'].links %}
          <li>
            <a href="{{ link.url }}">
              {{ link.title }}
            </a>
          </li>
        {% endfor %}
      </ul>
    </nav>

    <!-- NEWSLETTER -->
    <div class="hj-password-footer__column hj-password-footer__newsletter">
      <p class="hj-password-footer__label">STAY IN THE KNOW</p>

      <h2>Thoughtful gifting, delivered.</h2>

      <p class="hj-password-footer__newsletter-text">Join our mailing list for gifting inspiration and updates.</p>

      {% form 'customer', class: 'hj-password-footer__newsletter-form' %}
        <input
          type="hidden"
          name="contact[tags]"
          value="newsletter"
        >

        <div class="hj-password-footer__newsletter-field">
          <label
            for="PasswordFooterEmail"
            class="visually-hidden"
          >
            Email address
          </label>

          <input
            id="PasswordFooterEmail"
            type="email"
            name="contact[email]"
            placeholder="Email address"
            autocomplete="email"
            required
          >

          <button
            type="submit"
            aria-label="Subscribe to newsletter"
          >
            <span aria-hidden="true">→</span>
          </button>
        </div>

        {% if form.posted_successfully? %}
          <p class="hj-password-footer__message">Thank you for subscribing.</p>
        {% endif %}

        {% if form.errors %}
          <div class="hj-password-footer__message">
            {{ form.errors | default_errors }}
          </div>
        {% endif %}
      {% endform %}
    </div>
  </div>

  <!-- FOOTER BOTTOM -->
  <div class="hj-password-footer__bottom">
    <div class="hj-password-footer__bottom-inner page-width">
      <p>
        © {{ 'now' | date: '%Y' }}
        {{ shop.name }}
      </p>

      <p>
        Site designed and maintained by
        <a
          href="https://dedicateddesigner.in/"
          target="_blank"
          rel="noopener noreferrer"
        >
          Dedicated Designer
        </a>
      </p>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "HJ Password Footer",
  "settings": []
}
{% endschema %}
